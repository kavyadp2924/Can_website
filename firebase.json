{
  "hosting": {
    "public": "out",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],

    "//": "cleanUrls off: next.config.ts sets trailingSlash, so routes are already directories with index.html. Enabling both makes Firebase strip the slash and Next add it back — a redirect loop.",
    "cleanUrls": false,
    "trailingSlash": true,

    "headers": [
      {
        "//": "Hashed build assets are immutable — the filename changes when the content does, so they can be cached forever.",
        "source": "/_next/static/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "**/*.@(jpg|jpeg|png|webp|gif|svg|ico|woff|woff2)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
      },
      {
        "//": "HTML must revalidate, or a deploy leaves people on the old page until their cache expires.",
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
      },
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          }
        ]
      }
    ],

    "//redirects": "Old PHP URLs from the previous site, so existing links and search results keep working instead of 404ing.",
    "redirects": [
      { "//": "The VR page was folded into /visualization.",
        "source": "/vr", "destination": "/visualization/", "type": 301 },
      { "source": "/vr/", "destination": "/visualization/", "type": 301 },
      { "source": "/index.php", "destination": "/", "type": 301 },
      { "source": "/about.php", "destination": "/about/", "type": 301 },
      { "source": "/contact.php", "destination": "/contact/", "type": 301 },
      { "source": "/solutions.php", "destination": "/solutions/", "type": 301 },
      { "source": "/portfolio.php", "destination": "/work/", "type": 301 },
      { "source": "/engineering.php", "destination": "/solutions/engineering/", "type": 301 },
      { "source": "/unreal-studio.php", "destination": "/solutions/real-time-3d/", "type": 301 },
      {
        "source": "/architectural-experience.php",
        "destination": "/solutions/immersive-architecture/",
        "type": 301
      },
      { "source": "/AITraining.php", "destination": "/canorous-edge/", "type": 301 },
      { "source": "/presentation.php", "destination": "/products/presentation/", "type": 301 },
      { "source": "/privacy-policy.php", "destination": "/privacy/", "type": 301 },
      { "source": "/manufacturing.php", "destination": "/solutions/engineering/", "type": 301 },
      { "source": "/3d-studio.php", "destination": "/solutions/real-time-3d/", "type": 301 }
    ],

    "cleanUrlsNote": "404.html is generated by Next.js as out/404.html and picked up automatically."
  }
}

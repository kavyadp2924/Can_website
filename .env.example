# Baked in at BUILD time — a static site has no runtime environment, so this
# must be set before `next build`, not on the host.
NEXT_PUBLIC_SITE_URL=https://canorous.com

# GA4 measurement ID (e.g. G-XXXXXXXXXX). Leave unset to ship with no analytics.
NEXT_PUBLIC_GA_ID=

# Web3Forms access key — https://web3forms.com, used by the contact form and
# quote tool since this site has no backend of its own to receive submissions.
NEXT_PUBLIC_WEB3FORMS_KEY=
